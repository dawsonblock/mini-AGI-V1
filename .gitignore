.DS_Store
build/
build-cuda
build-*/
ds4-main/*

# Benchmark data is private/generated by default. Keep only audited public
# examples and small deterministic inputs visible to Git.
benchmark/*
!benchmark/manifest.env.example

!benchmark/mini_swe_deepswe/
benchmark/mini_swe_deepswe/*
!benchmark/mini_swe_deepswe/*.py
!benchmark/mini_swe_deepswe/*.md
!benchmark/mini_swe_deepswe/*.json
!benchmark/mini_swe_deepswe/*.sh

!benchmark/baselines/
benchmark/baselines/*
!benchmark/baselines/lm_eval/
benchmark/baselines/lm_eval/*
!benchmark/baselines/lm_eval/.gitkeep

!benchmark/claude_deepswe_ab/
benchmark/claude_deepswe_ab/*
!benchmark/claude_deepswe_ab/tasks_requestplan_10_no_happy.json
!benchmark/claude_deepswe_ab/durable_batch_supervisor.py

*.log

*.o
*.a
*.dylib
*.so

# Local model directories and standalone weight artifacts.
models/
*.gguf
*.ggml
*.safetensors
!results/**/*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
pytorch_model*.bin
adapter_model*.bin

__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.cache/
hf_cache/
minagi_work/
v162-validation-pack/
wandb/

# Signing keys must never be committed; the release public key stays.
*private*.pem
release-ed25519*.pem

# Local credentials and editor state. Checked-in examples should use the
# explicit *.example suffix.
.env
.env.*
!.env.example
.idea/
.vscode/
.claude/settings.local.json
*.pem
*.p12
!RELEASE_PUBLIC_KEY.pem

adaptive_mtp.md

# Vendored external benchmark harness (its own git repo, ~1.1 GB)
third_party/openhands-benchmarks/

# External OSWorld V2 harness/services and their large local VM/assets.
third_party/OSWorld-V2/
third_party/OSWorld-GitLab/

# Validation harness run outputs (regenerated locally; evidence lives on
# the results branch, not in source history)
ADVERSARIAL_CHECKS.json
IMPORT_PROBE.json
INTERRUPTION_RECOVERY.json
QUALIFICATION_RECORD.json
SCORER_CALIBRATION.json
# ...but on this branch those same names ARE the evidence: never ignore them
# under results/ (bare-name patterns above match at any depth).
!results/**/ADVERSARIAL_CHECKS.json
!results/**/IMPORT_PROBE.json
!results/**/INTERRUPTION_RECOVERY.json
!results/**/QUALIFICATION_RECORD.json
!results/**/SCORER_CALIBRATION.json
.keys/
