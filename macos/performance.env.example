# Generate values for your machine with:
# ./macos/qw3-mac apple-profile --model-weight-gib <GiB> --context 32768 --env-out apple-performance.env
export QW3_MAC_CONTEXT=32768
export QW3_MAC_PARALLEL=1
export QW3_MAC_FLASH_ATTN=1
# Optional, only after local qualification:
# export QW3_MAC_CACHE_K=q8_0
# export QW3_MAC_CACHE_V=q8_0
# export QW3_MAC_BATCH=512
# export QW3_MAC_UBATCH=128
# export QW3_DRAFT_MODEL=/path/to/qualified-draft.gguf
